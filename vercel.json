{
  "functions": {
    "api/store.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/store-apk",
      "destination": "/store.html"
    },
    {
      "source": "/store-apk/",
      "destination": "/store.html"
    },
    {
      "source": "/api/apps",
      "destination": "/api/store?action=list"
    },
    {
      "source": "/api/download/:id",
      "destination": "/api/store?action=download&id=:id"
    },
    {
      "source": "/api/latest/:id",
      "destination": "/api/store?action=latest&id=:id"
    },
    {
      "source": "/api/icon/:id",
      "destination": "/api/store?action=icon&id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/store",
      "destination": "/store-apk",
      "permanent": true
    },
    {
      "source": "/store/",
      "destination": "/store-apk",
      "permanent": true
    },
    {
      "source": "/store.html",
      "destination": "/store-apk",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' https://i.imgur.com data: blob:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(img|css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}